{
	"app-id": "space.fips.Fips",
	"runtime": "org.kde.Platform",
	"runtime-version": "6.10",
	"sdk": "org.kde.Sdk",
	"command": "fips",
	"finish-args": [
		"--share=ipc",
		"--share=network",
		"--socket=wayland",
		"--socket=fallback-x11",
		"--filesystem=host:ro",
		"--device=dri"
	],
	"modules": [
		{
			"name": "fips",
			"buildsystem": "cmake-ninja",
			"config-opts": [
				"-DCMAKE_BUILD_TYPE=RelWithDebInfo",
				"-DCMAKE_SKIP_INSTALL_RPATH:BOOL=ON",
				"-DQT_INTERNAL_SKIP_DEPLOYMENT:BOOL=ON"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/matwey/fips3",
					"tag": "3.5.0"
				}
			]
		}
	]
}
